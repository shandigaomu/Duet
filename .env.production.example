# Duet · 生产环境变量示例
# 复制：cp .env.production.example .env.production
# 勿提交 .env.production

# 宿主机 MySQL（容器内通过 host.docker.internal 访问）
DATABASE_URL="mysql://duet:CHANGE_ME@host.docker.internal:3306/duet"

BETTER_AUTH_SECRET="CHANGE_ME_USE_OPENSSL_RAND"
BETTER_AUTH_URL="https://duet.cutepet.online"
NEXT_PUBLIC_APP_URL="https://duet.cutepet.online"

COS_BUCKET="duet-1307511772"
COS_REGION="ap-guangzhou"
COS_SECRET_ID="CHANGE_ME"
COS_SECRET_KEY="CHANGE_ME"
COS_PUBLIC_URL="https://duet-1307511772.cos.ap-guangzhou.myqcloud.com"
COS_OBJECT_ACL="public-read"
