# Duet · 环境变量示例
# 复制为 .env 后填写本地值：cp .env.example .env

# MySQL（本地）
# Docker compose 默认：127.0.0.1:3307（见 docker-compose.yml）
# 本机 Homebrew MySQL 常见：127.0.0.1:3306
DATABASE_URL="mysql://duet:duet_pass@127.0.0.1:3307/duet"

# Better Auth
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://127.0.0.1:3000"

# 浏览器端同源即可；生产填公网域名
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"

# —— 腾讯云对象存储 COS（图片持久化）——
# 控制台：https://console.cloud.tencent.com/cos
# 未配置齐以下四项时，回退本地 .data/uploads（仅开发）
#
# 桶名称（含 APPID，如 duet-1250000000）
COS_BUCKET="duet-1250000000"
# 地域，如 ap-guangzhou / ap-shanghai / ap-beijing
COS_REGION="ap-guangzhou"
# API 密钥（建议子账号，仅授该桶读写）
COS_SECRET_ID=""
COS_SECRET_KEY=""
# 公网访问前缀（推荐 CDN 或桶默认域名）。不填则用：
#   https://{COS_BUCKET}.cos.{COS_REGION}.myqcloud.com
# COS_PUBLIC_URL="https://duet-1250000000.cos.ap-guangzhou.myqcloud.com"
# 对象 ACL：公读桶用 public-read；纯私有桶需另做签名（V1 用公读或 CDN）
# COS_OBJECT_ACL="public-read"
# 对象 key 前缀，默认 duet
# COS_KEY_PREFIX="duet"
