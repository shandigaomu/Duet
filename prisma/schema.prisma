generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// —— Better Auth ——
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?   @db.VarChar(512)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   SpaceMember[]
  checkIns      CheckIn[]
  entries       Entry[]
  dayMarks      DayMark[]
  entryReads    EntryRead[]
  listItems     ListItem[]
  notes         Note[]
  errorLogs     ErrorLog[]
  entryReactions EntryReaction[]
  pushSubscriptions PushSubscription[]
  notifyPref    NotifyPref?
  appLock       AppLock?
  hugsGiven     CheckInHug[]
  letters       Letter[]
  entrySections EntrySection[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(64)
  /// 手机浏览器 UA 常超过 191，需 TEXT
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// —— Duet 业务 ——
model Space {
  id        String        @id @default(cuid())
  inviteCode String       @unique @db.VarChar(12)
  /// 空间名（可选，P0-2）
  name      String?       @db.VarChar(20)
  /// 在一起那天（可选，YYYY-MM-DD，P0-2）
  anniversaryDay String?  @db.Char(10)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   SpaceMember[]
  checkIns  CheckIn[]
  entries   Entry[]
  dayMarks  DayMark[]
  listItems ListItem[]
  notes     Note[]
  letters   Letter[]

  @@map("space")
}

model SpaceMember {
  id        String   @id @default(cuid())
  spaceId   String
  userId    String
  nickname  String   @db.VarChar(40)
  avatarUrl String?  @db.VarChar(512)
  /// P2-N4：对方时区（IANA，如 Asia/Shanghai；null = 默认上海）
  timeZone  String?  @db.VarChar(64)
  joinedAt  DateTime @default(now())
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@unique([userId]) // V1：一用户仅一个空间
  @@map("space_member")
}

model CheckIn {
  id            String    @id @default(cuid())
  spaceId       String
  authorId      String
  /// Asia/Shanghai 自然日 YYYY-MM-DD
  day           String    @db.Char(10)
  mood          String?   @db.VarChar(16) // happy | ok | sad
  line          String    @db.VarChar(60)
  note          String?   @db.VarChar(200)
  imageUrl      String?   @db.VarChar(512)
  /// 对方已读时间
  partnerReadAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  space         Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  hugs          CheckInHug[]

  @@unique([spaceId, authorId, day])
  @@index([spaceId, day])
  @@map("check_in")
}

model Entry {
  id         String       @id @default(cuid())
  spaceId    String
  authorId   String
  day        String       @db.Char(10)
  title      String?      @db.VarChar(120)
  body       String       @db.Text
  /// shared | private（仅作者可见）
  visibility String       @default("shared") @db.VarChar(16)
  /// P2-N5：软删除时间（null = 正常；30 天后物理清理）
  deletedAt  DateTime?
  /// P2-N8：合写状态 none | pending | published
  collabStatus String     @default("none") @db.VarChar(16)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  space      Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images     EntryImage[]
  reads      EntryRead[]
  reactions  EntryReaction[]
  sections   EntrySection[]

  @@index([spaceId, day])
  @@index([spaceId, createdAt])
  @@index([spaceId, deletedAt])
  @@index([spaceId, collabStatus])
  @@map("entry")
}

/// 日记回应：一条日记限一条/人，预设表情 + 可选一句话（P0-1）
model EntryReaction {
  id        String   @id @default(cuid())
  entryId   String
  authorId  String
  emoji     String   @db.VarChar(8)
  body      String?  @db.VarChar(60)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([entryId, authorId])
  @@map("entry_reaction")
}

model EntryImage {
  id       String @id @default(cuid())
  entryId  String
  url      String @db.VarChar(512)
  sortOrder Int   @default(0)
  entry    Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("entry_image")
}

/// 日子标记：单日 + 可选周年重复；空间内双方可改删
model DayMark {
  id        String   @id @default(cuid())
  spaceId   String
  authorId  String
  /// Asia/Shanghai 自然日 YYYY-MM-DD（周年按月日重复）
  day       String   @db.Char(10)
  title     String   @db.VarChar(40)
  note      String?  @db.VarChar(200)
  yearly    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([spaceId, day])
  @@map("day_mark")
}

/// 日记已读：对方打开详情后标记
model EntryRead {
  id       String   @id @default(cuid())
  entryId  String
  readerId String
  readAt   DateTime @default(now())
  entry    Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  reader   User     @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@unique([entryId, readerId])
  @@index([entryId])
  @@map("entry_read")
}

/// 共同清单：想去的 / 想吃的 / 想做的
model ListItem {
  id          String    @id @default(cuid())
  spaceId     String
  authorId    String
  /// go | eat | do
  category    String    @db.VarChar(8)
  title       String    @db.VarChar(80)
  /// open | done
  status      String    @default("open") @db.VarChar(8)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([spaceId, status, category])
  @@map("list_item")
}

/// 悄悄话：留言 / 回复 / 置顶一句
model Note {
  id        String   @id @default(cuid())
  spaceId   String
  authorId  String
  body      String   @db.VarChar(500)
  parentId  String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Note?    @relation("NoteReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Note[]   @relation("NoteReplies")
  /// P2-N5：软删除时间（null = 正常；30 天后物理清理）
  deletedAt DateTime?

  @@index([spaceId, createdAt])
  @@index([parentId])
  @@index([spaceId, deletedAt])
  @@map("note")
}

/// P2-N2：抱抱（今日轻反应，每天每条 CheckIn 每人限一次）
model CheckInHug {
  id        String   @id @default(cuid())
  checkInId String
  checkIn   CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  giverId   String
  giver     User     @relation(fields: [giverId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([checkInId, giverId])
  @@map("check_in_hug")
}

/// P2-N3：时光信（写给未来的信，unlockDay 到达前收信方不可见内容）
model Letter {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String?  @db.VarChar(120)
  body      String   @db.VarChar(2000)
  imageUrl  String?  @db.VarChar(512)
  /// 解锁日 YYYY-MM-DD（必填，不得早于今天）
  unlockDay String   @db.Char(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId, unlockDay])
  @@map("letter")
}

/// P2-N8：合写日记的对方段落（作者段落即 Entry.body，无需迁移存量）
model EntrySection {
  id        String    @id @default(cuid())
  entryId   String
  entry     Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String    @db.Text
  images    Json?
  /// 该段作者点「确认完成」的时间；双方都确认 → Entry.collabStatus = published
  confirmedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([entryId, authorId])
  @@map("entry_section")
}

/// V3-N1：Web Push 订阅（一人可多设备）
model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String   @db.VarChar(512)
  /// sha256(endpoint) 前 32 字节 hex，用于唯一约束
  endpointHash String   @db.Char(64)
  p256dh       String   @db.VarChar(160)
  auth         String   @db.VarChar(64)
  createdAt    DateTime @default(now())

  @@unique([userId, endpointHash])
  @@map("push_subscriptions")
}

/// V3-N1/N2：通知偏好（每用户一行，无则全默认）
model NotifyPref {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Web Push 即时通知
  pushEnabled  Boolean  @default(true)
  /// 邮件即时通知（默认关，避免打扰）
  emailEnabled Boolean  @default(false)
  /// 每周一 9:00 摘要邮件
  emailWeekly  Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@map("notify_pref")
}

/// P2-N6：隐私锁 v1（4 位 PIN，锁在服务端）
model AppLock {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinHash   String   @db.VarChar(100)
  enabledAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_lock")
}

/// 客户端/服务端错误上报（P0-3，30 天自动清理）
model ErrorLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 页面路由，如 /journal
  route     String   @db.VarChar(120)
  /// client-error | unhandledrejection
  kind      String   @db.VarChar(24)
  message   String   @db.VarChar(300)
  stack     String?  @db.VarChar(2000)
  ua        String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("error_log")
}
