generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// —— Better Auth ——
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?   @db.VarChar(512)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   SpaceMember[]
  checkIns      CheckIn[]
  entries       Entry[]
  dayMarks      DayMark[]
  entryReads    EntryRead[]
  listItems     ListItem[]
  notes         Note[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(64)
  /// 手机浏览器 UA 常超过 191，需 TEXT
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// —— Duet 业务 ——
model Space {
  id        String        @id @default(cuid())
  inviteCode String       @unique @db.VarChar(12)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   SpaceMember[]
  checkIns  CheckIn[]
  entries   Entry[]
  dayMarks  DayMark[]
  listItems ListItem[]
  notes     Note[]

  @@map("space")
}

model SpaceMember {
  id        String   @id @default(cuid())
  spaceId   String
  userId    String
  nickname  String   @db.VarChar(40)
  avatarUrl String?  @db.VarChar(512)
  joinedAt  DateTime @default(now())
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@unique([userId]) // V1：一用户仅一个空间
  @@map("space_member")
}

model CheckIn {
  id            String    @id @default(cuid())
  spaceId       String
  authorId      String
  /// Asia/Shanghai 自然日 YYYY-MM-DD
  day           String    @db.Char(10)
  mood          String?   @db.VarChar(16) // happy | ok | sad
  line          String    @db.VarChar(60)
  note          String?   @db.VarChar(200)
  imageUrl      String?   @db.VarChar(512)
  /// 对方已读时间
  partnerReadAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  space         Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([spaceId, authorId, day])
  @@index([spaceId, day])
  @@map("check_in")
}

model Entry {
  id         String       @id @default(cuid())
  spaceId    String
  authorId   String
  day        String       @db.Char(10)
  title      String?      @db.VarChar(120)
  body       String       @db.Text
  /// shared | private（仅作者可见）
  visibility String       @default("shared") @db.VarChar(16)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  space      Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images     EntryImage[]
  reads      EntryRead[]

  @@index([spaceId, day])
  @@index([spaceId, createdAt])
  @@map("entry")
}

model EntryImage {
  id       String @id @default(cuid())
  entryId  String
  url      String @db.VarChar(512)
  sortOrder Int   @default(0)
  entry    Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("entry_image")
}

/// 日子标记：单日 + 可选周年重复；空间内双方可改删
model DayMark {
  id        String   @id @default(cuid())
  spaceId   String
  authorId  String
  /// Asia/Shanghai 自然日 YYYY-MM-DD（周年按月日重复）
  day       String   @db.Char(10)
  title     String   @db.VarChar(40)
  note      String?  @db.VarChar(200)
  yearly    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([spaceId, day])
  @@map("day_mark")
}

/// 日记已读：对方打开详情后标记
model EntryRead {
  id       String   @id @default(cuid())
  entryId  String
  readerId String
  readAt   DateTime @default(now())
  entry    Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  reader   User     @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@unique([entryId, readerId])
  @@index([entryId])
  @@map("entry_read")
}

/// 共同清单：想去的 / 想吃的 / 想做的
model ListItem {
  id          String    @id @default(cuid())
  spaceId     String
  authorId    String
  /// go | eat | do
  category    String    @db.VarChar(8)
  title       String    @db.VarChar(80)
  /// open | done
  status      String    @default("open") @db.VarChar(8)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([spaceId, status, category])
  @@map("list_item")
}

/// 悄悄话：留言 / 回复 / 置顶一句
model Note {
  id        String   @id @default(cuid())
  spaceId   String
  authorId  String
  body      String   @db.VarChar(500)
  parentId  String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Note?    @relation("NoteReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Note[]   @relation("NoteReplies")

  @@index([spaceId, createdAt])
  @@index([parentId])
  @@map("note")
}
